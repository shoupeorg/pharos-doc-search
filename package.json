{
  "name": "pharos-doc-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pharos Developer Docs MCP search CLI and web demo",
  "bin": {
    "pharos-docs": "./bin/pharos-docs.js"
  },
  "scripts": {
    "build": "esbuild ./src/worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=worker.js",
    "check": "node --test",
    "smoke": "node ./scripts/smoke.js",
    "deploy": "npm run build && wrangler deploy --no-bundle",
    "dev": "npm run build && wrangler dev",
    "login": "wrangler login"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=20"
  }
}
